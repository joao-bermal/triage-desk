{
  "id": "tdBacklogSweep1",
  "name": "Triage Desk · 4 Backlog sweep",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "5f4af725-4094-50fb-9c14-8d9dbf45c7aa",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/tickets?status=eq.new&received_at=lt.{{ new Date(Date.now() - 2 * 60 * 1000).toISOString() }}&select=id&order=received_at&limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "1eabebfa-6646-513e-a918-3f35b7370872",
      "name": "Find stuck tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "77060656-234e-5d80-af10-e8487628adb8",
      "name": "One at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/functions/v1/triage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-triage-secret",
              "value": "={{ $env.TRIAGE_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 150000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ticket_id: $json.id }) }}"
      },
      "id": "4c5af1d5-12a4-5135-b510-09f02b5fd1cb",
      "name": "Retry triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        380
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Find stuck tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find stuck tickets": {
      "main": [
        [
          {
            "node": "One at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One at a time": {
      "main": [
        [],
        [
          {
            "node": "Retry triage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retry triage": {
      "main": [
        [
          {
            "node": "One at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "tdErrorHandler01"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
