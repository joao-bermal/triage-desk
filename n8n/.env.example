# Values for the local n8n container (docker-compose.yml). Never commit the filled-in n8n/.env.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
# Must match supabase/functions/.env
TRIAGE_WEBHOOK_SECRET=
# Shared with whatever posts inbound messages (email parser, contact form, scripts/send-demo-messages.mjs)
INBOUND_WEBHOOK_SECRET=
# Must match private.settings.n8n_webhook_secret in the database (seed.sql uses local-webhook-secret)
N8N_WEBHOOK_SECRET=local-webhook-secret
# From the Shopify app that sends order webhooks
SHOPIFY_WEBHOOK_SECRET=
