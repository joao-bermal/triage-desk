# Next.js dashboard (Vercel project env vars). Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: lets staff re-run triage from the ticket page.
TRIAGE_FUNCTION_URL=http://127.0.0.1:54321/functions/v1/triage
TRIAGE_WEBHOOK_SECRET=
# Public demo only (see README): banner, and a one click demo login with a public agent account.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
